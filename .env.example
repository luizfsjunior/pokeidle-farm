# Copie para .env e preencha. NUNCA faça commit do .env.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modo memória (sem Supabase): uma conta só, para desenvolvimento.
# Com Supabase, os tokens ficam no Vault (pokeidle-farm set-token).
# Só nick, token e dispositivo. NUNCA senha (ver docs/decisions/0007).
ACCOUNT_1_NICK=
ACCOUNT_1_TOKEN=
ACCOUNT_1_DEVICE_ID=

# Worker
# Nome desta instância no lease das contas (ex.: notebook, droplet-1). Padrão: hostname.
# WORKER_HOLDER=notebook
# observe_only: nenhuma ação vai ao jogo (os plugins só registram o que fariam).
# enabled: plugins ligados em strategy_configs agem de verdade. Depois de mudar,
# docker compose up -d --force-recreate (o restart não relê o .env).
ACTION_MODE=observe_only

# Saída do jogo por proxy/VPN de IP fixo (ADR 0013). Vazio: conexão direta (PC de casa).
# Só o tráfego do jogo passa por ele; o Supabase vai direto. É segredo: não cole em lugar nenhum.
# GAME_PROXY_URL=http://usuario:senha@host:porta
# GAME_PROXY_URL=socks5://usuario:senha@host:porta
# Antes de cada conexão, o worker confere o IP de saída (ipapi.is; se falhar, ip-api.com).
# Datacenter ou sem confirmação: não conecta e tenta de novo depois (ADR 0015).
# EXIT_IP_CHECK=true
# Comandos do painel: de quantos em quantos segundos o worker busca os pendentes.
# COMMANDS_POLL_S=5
# Avisos no Discord (plugin notifier). Um webhook para as 4 contas (Discord: canal > Integrações >
# Webhooks > Copiar URL). É segredo: só aqui, nunca no banco. Vazio: nenhum aviso sai.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Base dos links dos avisos (a página da conta no painel).
# PANEL_URL=https://seu-painel.vercel.app
# Avisos por minuto somando as contas (o excesso vira um resumo "+N avisos").
# NOTIFY_PER_MINUTE=10
LOG_LEVEL=INFO
