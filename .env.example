# Copie para .env e preencha. NUNCA faça commit do .env.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modo memória (sem Supabase): uma conta só, para desenvolvimento.
# Com Supabase, os tokens ficam no Vault (pokeidle-farm set-token).
# Só nick, token e dispositivo. NUNCA senha (ver docs/decisions/0007).
ACCOUNT_1_NICK=
ACCOUNT_1_TOKEN=
ACCOUNT_1_DEVICE_ID=

# Worker
# Nome desta instância no lease das contas (ex.: notebook, droplet-1). Padrão: hostname.
# WORKER_HOLDER=notebook
# Na fase 2 o worker só observa; nenhuma ação é enviada ao jogo.
ACTION_MODE=observe_only
LOG_LEVEL=INFO
