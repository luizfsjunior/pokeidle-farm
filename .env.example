# Copie para .env e preencha. NUNCA faça commit do .env.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modo memória (sem Supabase): uma conta só, para desenvolvimento.
# Com Supabase, os tokens ficam no Vault (pokeidle-farm set-token).
# Só nick, token e dispositivo. NUNCA senha (ver docs/decisions/0007).
ACCOUNT_1_NICK=
ACCOUNT_1_TOKEN=
ACCOUNT_1_DEVICE_ID=

# Worker
# Nome desta instância no lease das contas (ex.: notebook, droplet-1). Padrão: hostname.
# WORKER_HOLDER=notebook
# observe_only: nenhuma ação vai ao jogo (os plugins só registram o que fariam).
# enabled: plugins ligados em strategy_configs agem de verdade. Depois de mudar,
# docker compose up -d --force-recreate (o restart não relê o .env).
ACTION_MODE=observe_only
LOG_LEVEL=INFO
