# Copie para .env e preencha. NUNCA faça commit do .env.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contas (durante o desenvolvimento; depois os tokens vão para a tabela account_tokens)
# Só nick, token e dispositivo. NUNCA senha (ver docs/decisions/0007).
ACCOUNT_1_NICK=
ACCOUNT_1_TOKEN=
ACCOUNT_1_DEVICE_ID=

# Worker
LOG_LEVEL=INFO
MIN_ACTION_INTERVAL_SECONDS=5
